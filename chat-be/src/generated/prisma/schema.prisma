////yeu cau prisma tao prisma client
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model usetime {
  id          Int      @id @default(autoincrement())
  email       String   @unique @db.VarChar(255)
  usePassword String   @db.VarChar(255)
  name        String?  @db.VarChar(100)
  avatar      String?  @db.VarChar(500)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.DateTime(3)

  refreshTokens       refestoken[]
  messages            Message[]
  conversationMembers ConversationMember[]
}

model refestoken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @db.VarChar(500)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      usetime  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "FK_Refestoken_UseTime")
  @@index([userId, createdAt])
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(10)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([email])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now()) @db.DateTime(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         usetime      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  content        String   @db.Text
  senderId       Int
  conversationId Int
  createdAt      DateTime @default(now()) @db.DateTime(3)

  sender       usetime      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
